{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditSummary",
  "type": "object",
  "required": [
    "audit_timestamp",
    "document_name",
    "file_stem",
    "version",
    "total_chunks_scanned",
    "total_words_evaluated",
    "simple_average_score",
    "weighted_average_score",
    "zero_detection_count",
    "zero_detection_percentage",
    "chunk_breakdown"
  ],
  "properties": {
    "audit_timestamp": { "type": "string" },
    "document_name": { "type": "string" },
    "file_stem": { "type": "string" },
    "version": { "type": "string" },
    "total_chunks_scanned": { "type": "integer", "minimum": 1 },
    "total_words_evaluated": { "type": "integer", "minimum": 0 },
    "simple_average_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "weighted_average_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "zero_detection_count": { "type": "integer", "minimum": 0 },
    "zero_detection_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
    "max_score_chunk": { "type": "object" },
    "chunk_breakdown": { "type": "array" }
  }
}
